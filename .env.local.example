# Налаштування Poster API
# 1. Створіть додаток в dev.joinposter.com
# 2. Отримайте ці ключі та скопіюйте їх у файл .env.local
POSTER_CLIENT_ID="your_client_id_here"
POSTER_CLIENT_SECRET="your_client_secret_here"

# Базовий URL вашого сайту для формування redirect_uri (без слешу в кінці)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Пароль для входу в спрощену адмінку (логін - admin)
ADMIN_PASSWORD="your_secure_password_here"
